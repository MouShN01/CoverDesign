CREATE TABLE AdaptedModel3DEntity (
    id                   TEXT    NOT NULL PRIMARY KEY,
    configId             TEXT    NOT NULL UNIQUE,
    baseModelId          TEXT    NOT NULL,   -- which base model this was adapted from
    modelUrl             TEXT,
    previewImageUrl      TEXT,
    status               TEXT    NOT NULL DEFAULT 'PENDING',
    generatedAt          INTEGER NOT NULL,
    error                TEXT,
    progress             INTEGER NOT NULL DEFAULT 0,
    estimatedWaitSeconds INTEGER,
    FOREIGN KEY (configId) REFERENCES ProductConfigEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (baseModelId) REFERENCES ProductEntity(id) ON DELETE CASCADE
);

insertOrReplaceAdaptedModel:
INSERT OR REPLACE INTO AdaptedModel3DEntity VALUES ?;

selectByConfigId:
SELECT * FROM AdaptedModel3DEntity
WHERE configId = :configId
LIMIT 1;

selectAdaptedById:
SELECT * FROM AdaptedModel3DEntity
WHERE id = :id;

updateAdaptedStatus:
UPDATE AdaptedModel3DEntity
SET status = :status
WHERE id = :id;