-- shared/commonMain/sqldelight/com/yourpackage/db/Model3D.sq

-- BASE model — one per product, seeded, used by the 3D browse tab only
CREATE TABLE Model3DEntity (
    id                   TEXT    NOT NULL PRIMARY KEY,
    productId            TEXT    NOT NULL,
    modelUrl             TEXT    NOT NULL,
    previewImageUrl      TEXT    NOT NULL DEFAULT '',
    status               TEXT    NOT NULL DEFAULT 'READY',
    generatedAt          INTEGER NOT NULL,
    FOREIGN KEY (productId) REFERENCES ProductEntity(id) ON DELETE CASCADE
);

insertOrReplaceModel3D:
INSERT OR REPLACE INTO Model3DEntity VALUES ?;

selectByProductId:
SELECT * FROM Model3DEntity
WHERE productId = :productId
LIMIT 1;

selectModel3DById:
SELECT * FROM Model3DEntity
WHERE id = :id;

deleteByProductId:
DELETE FROM Model3DEntity
WHERE productId = :productId;